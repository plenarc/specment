{
  "name": "specment",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "exec biome check --apply .",
    "format": "exec biome format . --write",
    "lint": "exec biome lint .",
    "lint:fix": "exec biome lint . --fix",
    "docs:start": "pnpm --filter @specment/website start",
    "docs:build": "pnpm --filter @specment/website build",
    "docs:serve": "pnpm --filter @specment/website serve",
    "specment:build": "pnpm --filter @plenarc/specment build",
    "build:all": "pnpm --filter @plenarc/specment build && pnpm --filter @specment/website build",
    "typecheck": "tsc",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm specment:build && changeset publish",
    "changeset:status": "changeset status",
    "release": "pnpm changeset:version && pnpm changeset:publish",
    "test:workflow": "node scripts/run-workflow-tests.js",
    "test:workflow:syntax": "node scripts/test-workflow-validation.js",
    "test:workflow:branch": "node scripts/test-branch-workflow.js",
    "test:workflow:npm": "node scripts/test-npm-publish.js",
    "test:workflow:errors": "node scripts/test-error-scenarios.js",
    "security:check": "node scripts/security-check.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:integration:workflow": "node scripts/test-integration-workflow.js",
    "test:integration:package": "node scripts/verify-published-package.js",
    "test:integration:create-pr": "node scripts/create-test-pr.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.2.1",
    "typescript": "~5.9.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "core-js-pure"
    ],
    "onlyBuiltDependencies": [
      "core-js-pure"
    ]
  }
}