{
  // @docusaurus/tsconfig は TypeScript 7 で削除された baseUrl を含むため extends できない (3.10.2 時点で未修正)。
  // Docusaurus 側が対応したら extends: "@docusaurus/tsconfig" に戻す。
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "docs/**/*",
    "docusaurus.config.ts",
    "sidebars.ts"
  ]
}
